{
  "name": "pedizza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "format": "prettier --write src tests scripts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:dist:win": "npm --prefix desktop run dist:win"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "jose": "^6.2.12",
    "lucide-react": "latest",
    "next": "^16.3.2",
    "nodemailer": "^10.0.14",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.2",
    "prettier": "^3.9.9",
    "sharp": "latest",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "latest"
  }
}
