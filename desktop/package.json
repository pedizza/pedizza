{
  "name": "pedizza-gestor-de-pedidos",
  "version": "1.0.2",
  "description": "Aplicativo de gestão em tempo real do Pedizza.",
  "author": "Pedizza",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "dev": "electron main.mjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "br.com.pedizza.gestor",
    "productName": "Pedizza",
    "copyright": "Copyright © 2026 Pedizza",
    "electronVersion": "44.5.1",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "pt-BR"
    ],
    "directories": {
      "output": "../dist/windows",
      "buildResources": "assets"
    },
    "files": [
      "main.mjs",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Pedizza-Gestor-de-Pedidos-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pedizza",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
