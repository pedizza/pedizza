# Copie para .env.local. Nunca commite valores reais.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Backend: leituras com papel authenticated/RLS; escritas validadas no servidor.
DATABASE_URL=
DIRECT_URL=
SUPABASE_DB_CA_PATH=config/supabase-ca.crt
# Opcional: certificado PEM como variável; usado no runtime no lugar do arquivo.
SUPABASE_DB_CA=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
GEOAPIFY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# AES-256-GCM, 32 bytes em base64, para credenciais por tenant
INTEGRATION_ENCRYPTION_KEY=
BRAVOPAY_API_KEY=
BRAVOPAY_WEBHOOK_SECRET=
BRAVOPAY_PRODUCT_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
SUPPORT_EMAIL=
# Autenticação própria; segredo aleatório de pelo menos 32 bytes, somente servidor.
JWT_SECRET=
# Confirmação de cadastro, recuperação e convites
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
